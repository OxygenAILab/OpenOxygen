# OpenOxygen Next 环境变量配置
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# ── Planner（LLM 规划层）────────────────────────────────
# SimplePlanner 走 OpenAI 兼容协议；回退读取 OPENAI_API_KEY
OPENOXYGEN_PLANNER_API_KEY=sk-your-key-here
OPENOXYGEN_PLANNER_MODEL=cerebras/gemma-4-31b
OPENOXYGEN_PLANNER_BASE_URL=https://api.123nhh.com/v1

# ── 通用 LLM（CLI / SDK 默认 provider）─────────────────
# 可选：ollama / openai / anthropic
OPENOXYGEN_PROVIDER=ollama
# OPENOXYGEN_BASE_URL=
# OPENOXYGEN_API_KEY=
# OPENOXYGEN_MODEL=

# ── 执行层 ──────────────────────────────────────────────
MAX_RETRIES=3
DEFAULT_TIMEOUT=30000
ENABLE_REFLECTION=true
