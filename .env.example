# OpenOxygen Next 环境变量配置
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# ── LLM 主配置(agent/chat/execute/planner 通用回退链)────
# 所有 LLM 命令共用:显式 --provider/--model/--url/--key > 通用变量 > 本组变量
OPENOXYGEN_PLANNER_API_KEY=sk-your-key-here
OPENOXYGEN_PLANNER_MODEL=glm-5.3-flash
OPENOXYGEN_PLANNER_BASE_URL=https://api.ldwnb666.xyz/v1

# ── 通用 LLM（CLI / SDK 默认 provider）─────────────────
# 可选：ollama / openai / anthropic
OPENOXYGEN_PROVIDER=ollama
# OPENOXYGEN_BASE_URL=
# OPENOXYGEN_API_KEY=
# OPENOXYGEN_MODEL=

# ── 执行层 ──────────────────────────────────────────────
MAX_RETRIES=3
DEFAULT_TIMEOUT=30000
ENABLE_REFLECTION=true
